# Скопіюй цей файл у Render як Environment Variables (Settings → Environment).
# Нічого з реальними значеннями НЕ комітиться в git — .env у .gitignore.

# Токен бота від @BotFather (той самий, що видали при /newbot)
BOT_TOKEN=

# Довільний секретний рядок власного вигаду (просто набір випадкових символів) —
# захищає /webhook від сторонніх запитів. Приклад: openssl rand -hex 20
WEBHOOK_SECRET=

# Ще один секрет — для захисту адмінських ендпоінтів (розсилки)
ADMIN_SECRET=

# Дані бази Turso (див. README.md, розділ "Крок 1")
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Адреса твого застосунку на GitHub Pages (для CORS) — без слеша в кінці
FRONTEND_ORIGIN=https://grekis5552.github.io

# Тарифи (місяць/рік/назавжди) тепер задаються в коді — src/pricing.js,
# а не через environment variable. Онови ціни там, якщо треба їх змінити.
